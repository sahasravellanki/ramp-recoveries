# Copy to backend/.env and fill in. Never commit .env.

# Leave empty (or set DEMO_MODE=1) to run on keyword rules + template letters.
ANTHROPIC_API_KEY=

# 1 = no AI calls; deterministic rules and templates so the demo never breaks.
DEMO_MODE=1

# Tier 1: fast labeling of invoice lines.
CLAWBACK_MODEL_TIER1=claude-haiku-4-5
# Tier 2: claim letter drafting and ambiguous-case review.
CLAWBACK_MODEL_TIER2=claude-sonnet-4-5

DATABASE_URL=sqlite:///./clawback.db
DATA_DIR=../data
