# Copy to backend/.env and fill in. Never commit .env.

# Ships with saved results from a real model run. Set a key to re-run live.
ANTHROPIC_API_KEY=

# Set to 1 to force keyword rules and template letters. Leave unset otherwise.
# DEMO_MODE=1

# Tier 1: fast labeling of invoice lines.
RECOVERIES_MODEL_TIER1=claude-haiku-4-5
# Tier 2: claim letter drafting and ambiguous-case review.
RECOVERIES_MODEL_TIER2=claude-sonnet-4-5

DATABASE_URL=sqlite:///./recoveries.db
DATA_DIR=../data
